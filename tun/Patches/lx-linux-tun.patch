+#ifdef TUNTAP_TUN
+static void tuniocack_data(queue_t *wq, mblk_t *mp, int ret)
+{
+  struct iocblk *ioc = (struct iocblk *)mp->b_rptr;
+
+  mp->b_datap->db_type = M_IOCACK;
+  ioc->ioc_count = sizeof(struct tun_lx_ifreq);
+  ioc->ioc_error = 0;
+  ioc->ioc_rval = ret;
+  qreply(wq, mp);
+}
+
+static int tun_lx_stream_ioctl(ldi_handle_t handle, int command, void *arg,
+                               size_t size, cred_t *cred)
+{
+  struct strioctl ioc;
+  int rval;
+
+  ioc.ic_cmd = command;
+  ioc.ic_timout = 15;
+  ioc.ic_len = size;
+  ioc.ic_dp = arg;
+  return ldi_ioctl(handle, I_STR, (intptr_t)&ioc, FKIOCTL, cred, &rval);
+}
+
+struct tun_lx_cleanup {
+  ldi_handle_t mux;
+  int muxid;
+  cred_t *cred;
+};
+
+struct tun_lx_plumb_work {
+  queue_t *wq;
+  mblk_t *mp;
+};
+
+static void tun_lx_cleanup_task(void *arg)
+{
+  struct tun_lx_cleanup *cleanup = arg;
+  int rval;
+  int flags = FREAD | FWRITE | FNOCTTY | FKIOCTL;
+
+  if (cleanup->muxid != -1)
+     (void) ldi_ioctl(cleanup->mux, I_PUNLINK, cleanup->muxid, flags,
+                      cleanup->cred, &rval);
+  (void) ldi_close(cleanup->mux, FREAD | FWRITE, cleanup->cred);
+  crfree(cleanup->cred);
+  kmem_free(cleanup, sizeof(*cleanup));
+}
+
+static void tun_lx_unplumb(struct tunppa *ppa)
+{
+  struct tun_lx_cleanup *cleanup;
+  taskqid_t id;
+
+  if (ppa->lx_mux == NULL)
+     return;
+  cleanup = kmem_alloc(sizeof(*cleanup), KM_SLEEP);
+  cleanup->mux = ppa->lx_mux;
+  cleanup->muxid = ppa->lx_muxid;
+  cleanup->cred = ppa->lx_cred;
+  ppa->lx_mux = NULL;
+  ppa->lx_muxid = -1;
+  ppa->lx_cred = NULL;
+  ppa->lx_name[0] = '\0';
+  id = taskq_dispatch(system_taskq, tun_lx_cleanup_task, cleanup, TQ_SLEEP);
+  VERIFY(id != TASKQID_INVALID);
+}
+
+static int tun_lx_plumb(struct tunstr *str, struct tun_lx_ifreq *req,
+                        cred_t *cred)
+{
+  struct tunppa *ppa = str->ppa;
+  ldi_handle_t lower = NULL;
+  ldi_handle_t mux = NULL;
+  struct lifreq lifr;
+  struct ifreq ifr;
+  int error;
+  int muxid = -1;
+  int rval;
+  int flags = FREAD | FWRITE | FNOCTTY | FKIOCTL;
+  zone_t *zone;
+  cred_t *netcred;
+
+  if (secpolicy_net_config(cred, B_FALSE) != 0)
+     return EPERM;
+  if (ppa == NULL || (str->flags & TUN_CONTROL) == 0 ||
+      ppa->id != req->ppa)
+     return EINVAL;
+  if (ppa->lx_mux != NULL)
+     return EBUSY;
+  if (req->zoneid == GLOBAL_ZONEID ||
+      (zone = zone_find_by_id(req->zoneid)) == NULL)
+     return EINVAL;
+  netcred = zone->zone_kcred;
+  crhold(netcred);
+  zone_rele(zone);
+
+  error = ldi_open_by_name("/dev/tun", FREAD | FWRITE, netcred, &lower,
+                           tun_ldi);
+  if (error != 0)
+     goto out;
+  error = ldi_ioctl(lower, I_PUSH, (intptr_t)"ip", FKIOCTL, netcred,
+                    &rval);
+  if (error != 0)
+     goto out;
+
+  bzero(&lifr, sizeof(lifr));
+  (void) strlcpy(lifr.lifr_name, req->name, sizeof(lifr.lifr_name));
+  lifr.lifr_ppa = ppa->id;
+  lifr.lifr_flags = IFF_IPV4 | IFF_NOARP;
+  error = tun_lx_stream_ioctl(lower, SIOCSLIFNAME, &lifr, sizeof(lifr),
+                              netcred);
+  if (error != 0)
+     goto out;
+
+  error = ldi_open_by_name("/dev/udp", FREAD | FWRITE, netcred, &mux,
+                           tun_ldi);
+  if (error != 0)
+     goto out;
+  error = ldi_ioctl(mux, I_PLINK, (intptr_t)lower, flags, netcred, &muxid);
+  if (error != 0)
+     goto out;
+
+  bzero(&ifr, sizeof(ifr));
+  (void) strlcpy(ifr.ifr_name, req->name, sizeof(ifr.ifr_name));
+  ifr.ifr_ip_muxid = muxid;
+  ifr.ifr_arp_muxid = 0;
+  error = ldi_ioctl(mux, SIOCSIFMUXID, (intptr_t)&ifr, FKIOCTL, netcred,
+                    &rval);
+  if (error != 0)
+     goto out;
+
+  ppa->lx_mux = mux;
+  ppa->lx_muxid = muxid;
+  ppa->lx_cred = netcred;
+  ppa->lx_zoneid = req->zoneid;
+  (void) strlcpy(ppa->lx_name, req->name, sizeof(ppa->lx_name));
+  mux = NULL;
+  muxid = -1;
+  netcred = NULL;
+
+out:
+  if (error != 0 && mux != NULL && muxid != -1)
+     (void) ldi_ioctl(mux, I_PUNLINK, muxid, flags, netcred, &rval);
+  if (lower != NULL)
+     (void) ldi_close(lower, FREAD | FWRITE, netcred);
+  if (mux != NULL)
+     (void) ldi_close(mux, FREAD | FWRITE, netcred);
+  if (netcred != NULL)
+     crfree(netcred);
+  return error;
+}
+
+static void tun_lx_plumb_ioctl(queue_t *wq, mblk_t *mp)
+{
+  struct iocblk *ioc = (struct iocblk *)mp->b_rptr;
+  struct tunstr *str = (struct tunstr *)wq->q_ptr;
+  struct tun_lx_ifreq *req;
+  int error;
+
+  if (mp->b_cont == NULL || MBLKL(mp->b_cont) < sizeof(*req)) {
+     tuniocack(wq, mp, M_IOCNAK, 0, EINVAL);
+     return;
+  }
+  req = (struct tun_lx_ifreq *)mp->b_cont->b_rptr;
+  error = tun_lx_plumb(str, req, ioc->ioc_cr);
+  if (error != 0) {
+     tuniocack(wq, mp, M_IOCNAK, 0, error);
+     return;
+  }
+  tuniocack_data(wq, mp, 0);
+}
+
+static void tun_lx_plumb_task(void *arg)
+{
+  struct tun_lx_plumb_work *work = arg;
+
+  tun_lx_plumb_ioctl(work->wq, work->mp);
+  kmem_free(work, sizeof(*work));
+}
+
+static void tun_lx_plumb_defer(queue_t *wq, mblk_t *mp)
+{
+  struct tun_lx_plumb_work *work;
+
+  work = kmem_alloc(sizeof(*work), KM_NOSLEEP);
+  if (work == NULL) {
+     tuniocack(wq, mp, M_IOCNAK, 0, ENOMEM);
+     return;
+  }
+  work->wq = wq;
+  work->mp = mp;
+  if (taskq_dispatch(system_taskq, tun_lx_plumb_task, work,
+                     TQ_NOSLEEP) == TASKQID_INVALID) {
+     kmem_free(work, sizeof(*work));
+     tuniocack(wq, mp, M_IOCNAK, 0, EAGAIN);
+  }
+}
