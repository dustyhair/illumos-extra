+#ifdef TUNTAP_TUN
+static int tun_lx_requested_ppa(const char *name)
+{
+  int id = 0;
+  const char *p;
+
+  if (strncmp(name, "tun", 3) != 0 || name[3] == '\0')
+     return -1;
+  for (p = name + 3; *p != '\0'; p++) {
+     if (*p < '0' || *p > '9')
+        return -1;
+     id = id * 10 + (*p - '0');
+     if (id >= TUNMAXPPA)
+        return -1;
+  }
+  return id;
+}
+#endif
